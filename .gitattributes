# Do not track licensed/private participant media as repository files.
# Dataset and runtime paths are excluded in .gitignore and .dockerignore.

# Model artifacts, if explicitly approved for distribution, use Git LFS.
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
